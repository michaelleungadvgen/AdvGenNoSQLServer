<Window x:Class="AdvGenNoSqlServer.Examples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdvGenNoSQL Embedded — Example"
        Width="820" Height="580"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">

        <!-- Typed API demo: POCO entities via IEmbeddedCollection&lt;T&gt; -->
        <TabItem Header="Todos (typed API)">
            <DockPanel>

                <!-- Add row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="380" VerticalContentAlignment="Center" ToolTip="New task title"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Add" Width="80" Margin="8,0,0,0" IsDefault="True"
                            Command="{Binding AddCommand}"/>
                </StackPanel>

                <!-- Status bar -->
                <StatusBar DockPanel.Dock="Bottom">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusText}"/>
                    </StatusBarItem>
                </StatusBar>

                <!-- Filter / search / actions row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="All" GroupName="TodoFilter" VerticalAlignment="Center"
                                 IsChecked="{Binding FilterAll}"/>
                    <RadioButton Content="Active" GroupName="TodoFilter" VerticalAlignment="Center"
                                 Margin="8,0,0,0" IsChecked="{Binding FilterActive}"/>
                    <RadioButton Content="Completed" GroupName="TodoFilter" VerticalAlignment="Center"
                                 Margin="8,0,0,0" IsChecked="{Binding FilterCompleted}"/>
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="24,0,4,0"/>
                    <TextBox Width="180" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Delete" Width="90" Margin="24,0,0,0"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="Clear completed" Width="120" Margin="8,0,0,0"
                            Command="{Binding ClearCompletedCommand}"/>
                    <Button Content="Refresh" Width="80" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}"/>
                    <Button Content="Checkpoint" Width="90" Margin="8,0,0,0"
                            ToolTip="Flush the write-ahead log into the main database file"
                            Command="{Binding CheckpointCommand}"/>
                </StackPanel>

                <!-- Items -->
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Done" Width="60"
                                                Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Task" Width="*"
                                            Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="Created" Width="150" IsReadOnly="True"
                                            Binding="{Binding CreatedAt, StringFormat=g}"/>
                        <DataGridTextColumn Header="Id" Width="230" IsReadOnly="True"
                                            Binding="{Binding Id}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </TabItem>

        <!-- Untyped API demo: schema-less Documents via EmbeddedCollection -->
        <TabItem Header="Notes (untyped API)" DataContext="{Binding Notes}">
            <DockPanel>

                <!-- Add row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="220" VerticalContentAlignment="Center" ToolTip="Note title"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="320" VerticalContentAlignment="Center" ToolTip="Note body"
                             Margin="8,0,0,0"
                             Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Add" Width="80" Margin="8,0,0,0" IsDefault="True"
                            Command="{Binding AddCommand}"/>
                </StackPanel>

                <!-- Status bar -->
                <StatusBar DockPanel.Dock="Bottom">
                    <StatusBarItem>
                        <TextBlock Text="{Binding StatusText}"/>
                    </StatusBarItem>
                </StatusBar>

                <!-- Actions row -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Delete" Width="90"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="Refresh" Width="80" Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <!-- Documents (columns bind straight into the payload dictionary) -->
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Width="230"
                                            Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Title" Width="180"
                                            Binding="{Binding Data[title]}"/>
                        <DataGridTextColumn Header="Body" Width="*"
                                            Binding="{Binding Data[body]}"/>
                        <DataGridTextColumn Header="Created" Width="140"
                                            Binding="{Binding Data[createdAt]}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </DockPanel>
        </TabItem>

    </TabControl>
</Window>
