<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>
    <MudNavLink Href="collections" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">
        Collections
    </MudNavLink>
    <MudNavLink Href="documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
        Documents
    </MudNavLink>
    <MudNavLink Href="query" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Terminal">
        Console
    </MudNavLink>
    @if (Role == "admin")
    {
        <MudNavLink Href="users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
            Users
        </MudNavLink>
    }
</MudNavMenu>

@code {
    // Passed from MainLayout so Blazor re-renders the menu when the role changes
    // after login; a parameterless child would otherwise keep its pre-login state.
    [Parameter] public string? Role { get; set; }
}
