@page "/"
@namespace AdvGenNoSqlServer.AdminClient.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AdvGenNoSQL Admin Client</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:1200;padding:0.75rem 1rem;background:#b71c1c;color:#fff;text-align:center;box-shadow:0 -1px 4px rgba(0,0,0,.3);">
        The connection to the server was lost.
        <a href="" class="reload" style="color:#fff;text-decoration:underline;">Reload</a>
        <a class="dismiss" style="color:#fff;cursor:pointer;float:right;">&times;</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/download.js"></script>
</body>
</html>
