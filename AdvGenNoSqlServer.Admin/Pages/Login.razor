@page "/login"
@inject AdminAuthService AuthService
@inject ServerConnectionService ConnectionService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Login - AdvGenNoSQL Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%;">
        <div class="d-flex justify-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Large" Color="Color.Primary" Style="font-size: 64px;" />
        </div>
        
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2">AdvGenNoSQL Admin</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">Web Administration Console</MudText>
        
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudButtonGroup Variant="Variant.Outlined" Class="mb-2">
                <MudButton Color="@HttpColor" OnClick="SelectHttp">HTTP</MudButton>
                <MudButton Color="@HttpsColor" OnClick="SelectHttps">HTTPS</MudButton>
            </MudButtonGroup>
            <MudTextField T="string"
                          @bind-Value="_serverUrl"
                          Label="Server URL"
                          Variant="Variant.Outlined"
                          Placeholder="localhost:9191"
                          HelperText="@_urlHelperText"
                          Required="true"
                          RequiredError="Server URL is required"
                          Class="mb-4" />
            
            <MudTextField T="string" 
                          @bind-Value="_username"
                          Label="Username" 
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Username is required"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Class="mb-4" />
            
            <MudTextField T="string" 
                          @bind-Value="_password"
                          Label="Password" 
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Password is required"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Lock"
                          Class="mb-6" />
            
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleLogin"
                       Disabled="_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Connecting...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </MudButton>
        </MudForm>
        
        <MudDivider Class="my-4" />
        
        <MudText Typo="Typo.caption" Align="Align.Center" Class="d-block">
            AdvGenNoSQL Server v1.0.0 - MIT License
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private bool _isValid;
    private bool _isLoading;
    
    private string _serverUrl = "localhost:9191";
    private string _protocol = "http";
    private string _urlHelperText => $"Enter TCP port — HTTPS API connects on TCP port+1";
    private void SelectHttp() => _protocol = "http";
    private void SelectHttps() => _protocol = "https";
    private Color HttpColor => _protocol == "http" ? Color.Primary : Color.Default;
    private Color HttpsColor => _protocol == "https" ? Color.Primary : Color.Default;
    private string _username = "";
    private string _password = "";

    protected override void OnInitialized()
    {
        // Redirect if already authenticated
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin()
    {
        if (_form != null)
        {
            await _form.Validate();
        }
        
        if (!_isValid) return;
        
        _isLoading = true;
        
        try
        {
            // First connect to server — pass protocol so DeriveApiUrl uses it
            var cleanUrl = _serverUrl.Replace("http://", string.Empty).Replace("https://", string.Empty);
            var connected = await ConnectionService.ConnectAsync($"{_protocol}://{cleanUrl}");
            if (!connected)
            {
                var detail = ConnectionService.LastConnectError ?? "No response";
                Snackbar.Add($"Failed to connect: {detail}", Severity.Error);
                return;
            }
            
            // Then authenticate (must be before calling secured endpoints)
            var success = await AuthService.LoginAsync(_username, _password, _serverUrl);
            if (!success)
            {
                Snackbar.Add("Invalid credentials", Severity.Error);
                return;
            }
            
            // Now load databases and select the default one (requires auth)
            var databases = await ConnectionService.GetDatabasesAsync();
            if (databases.Any())
            {
                var defaultDb = databases.First();
                await ConnectionService.SelectDatabaseAsync(defaultDb);
            }
            
            Snackbar.Add("Login successful!", Severity.Success);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
