@page "/documents"
@inject ServerConnectionService ConnectionService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Documents - AdvGenNoSQL Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Documents</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string" 
                       Value="_selectedCollection"
                       ValueChanged="OnCollectionChanged"
                       Label="Collection"
                       Variant="Variant.Outlined"
                       Dense="true">
                @foreach (var collection in _collections)
                {
                    <MudSelectItem Value="@collection">@collection</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" 
                          @bind-Value="_searchTerm"
                          Placeholder="Search documents..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          OnKeyUp="SearchDocuments" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="CreateDocument"
                       Disabled="string.IsNullOrEmpty(_selectedCollection)">
                New
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-4" />
}
else if (_filteredDocuments?.Any() != true)
{
    <MudAlert Severity="Severity.Info" Class="my-4">
        No documents found. Select a collection or create a new document.
    </MudAlert>
}
else
{
    <MudTable Items="_filteredDocuments" 
              Dense="true" 
              Hover="true" 
              Bordered="true"
              Striped="true">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Preview</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">
                <MudText Typo="Typo.caption" Style="font-family: monospace;">
                    @context.Id
                </MudText>
            </MudTd>
            <MudTd DataLabel="Preview">
                <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 400px;">
                    @GetDocumentPreview(context)
                </MudText>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="() => ViewDocument(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Size="Size.Small"
                               Color="Color.Default"
                               OnClick="() => EditDocument(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Size="Size.Small"
                               Color="Color.Error"
                               OnClick="() => DeleteDocument(context)" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<string> _collections = new();
    private string _selectedCollection = "";
    private List<Document>? _documents;
    private List<Document>? _filteredDocuments;
    private bool _isLoading;
    private string _searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCollections();
        
        // Check for collection in query string
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = ParseQueryString(uri.Query);
        if (queryParams.TryGetValue("collection", out var collection) && !string.IsNullOrEmpty(collection))
        {
            _selectedCollection = collection;
            await LoadDocuments();
        }
    }

    private static Dictionary<string, string> ParseQueryString(string query)
    {
        var result = new Dictionary<string, string>();
        if (string.IsNullOrEmpty(query) || query == "?") return result;
        
        var queryPart = query.StartsWith('?') ? query[1..] : query;
        var pairs = queryPart.Split('&');
        
        foreach (var pair in pairs)
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2)
            {
                var key = Uri.UnescapeDataString(parts[0]);
                var value = Uri.UnescapeDataString(parts[1]);
                result[key] = value;
            }
        }
        
        return result;
    }

    private async Task LoadCollections()
    {
        _collections = await ConnectionService.GetCollectionsAsync();
        if (_collections.Any() && string.IsNullOrEmpty(_selectedCollection))
        {
            _selectedCollection = _collections.First();
            await LoadDocuments();
        }
    }

    private async Task OnCollectionChanged(string collection)
    {
        _selectedCollection = collection;
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        if (string.IsNullOrEmpty(_selectedCollection)) return;
        
        _isLoading = true;
        try
        {
            _documents = await ConnectionService.GetDocumentsAsync(_selectedCollection, 0, 100);
            FilterDocuments();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load documents: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void FilterDocuments()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredDocuments = _documents;
        }
        else if (_documents != null)
        {
            _filteredDocuments = _documents.Where(d => 
                d.Id.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                GetDocumentPreview(d).Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private async Task SearchDocuments()
    {
        FilterDocuments();
        await Task.CompletedTask;
    }

    private string GetDocumentPreview(Document doc)
    {
        if (doc.Data.TryGetValue("name", out var name))
            return name?.ToString() ?? "(no name)";
        if (doc.Data.TryGetValue("title", out var title))
            return title?.ToString() ?? "(no title)";
        
        // Return first few properties
        var preview = string.Join(", ", doc.Data.Take(3).Select(kvp => $"{kvp.Key}: {kvp.Value}"));
        return string.IsNullOrEmpty(preview) ? "(empty)" : preview;
    }

    private void ViewDocument(Document doc)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(doc.Data, new System.Text.Json.JsonSerializerOptions 
        { 
            WriteIndented = true 
        });
        
        var parameters = new DialogParameters
        {
            ["Title"] = $"Document: {doc.Id}",
            ["Content"] = json
        };
        
        DialogService.Show<DocumentViewDialog>("View Document", parameters);
    }

    private async Task EditDocument(Document doc)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = "Edit Document",
            ["CollectionName"] = _selectedCollection,
            ["Document"] = doc
        };
        
        var dialog = await DialogService.ShowAsync<DocumentEditDialog>("Edit Document", parameters);
        var result = await dialog.Result;
        
        if (result?.Canceled == false && result.Data is DocumentEditDialog.DocumentResult docResult)
        {
            var updatedDoc = new Document
            {
                Id = docResult.Id,
                Data = docResult.Data
            };
            
            var (success, error) = await ConnectionService.UpdateDocumentAsync(_selectedCollection, updatedDoc);
            if (success)
            {
                Snackbar.Add("Document updated successfully", Severity.Success);
                await LoadDocuments();
            }
            else
            {
                Snackbar.Add($"Failed to update document: {error}", Severity.Error);
            }
        }
    }

    private async Task DeleteDocument(Document doc)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Delete Document" },
            { x => x.Message, $"Are you sure you want to delete document '{doc.Id}'? This action cannot be undone." },
            { x => x.ConfirmText, "Delete" }
        };
        
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Delete", parameters);
        var result = await dialog.Result;
        
        if (result?.Canceled == true) return;
        
        var success = await ConnectionService.DeleteDocumentAsync(_selectedCollection, doc.Id);
        if (success)
        {
            Snackbar.Add($"Document '{doc.Id}' deleted", Severity.Success);
            await LoadDocuments();
        }
        else
        {
            Snackbar.Add($"Failed to delete document '{doc.Id}'", Severity.Error);
        }
    }

    private async Task CreateDocument()
    {
        if (string.IsNullOrEmpty(_selectedCollection))
        {
            Snackbar.Add("Please select a collection first", Severity.Warning);
            return;
        }
        
        var parameters = new DialogParameters
        {
            ["Title"] = "Create New Document",
            ["CollectionName"] = _selectedCollection
        };
        
        var dialog = await DialogService.ShowAsync<DocumentEditDialog>("Create Document", parameters);
        var result = await dialog.Result;
        
        if (result?.Canceled == false && result.Data is DocumentEditDialog.DocumentResult docResult)
        {
            var newDoc = new Document
            {
                Id = docResult.Id,
                Data = docResult.Data
            };
            
            var (success, docId, error) = await ConnectionService.InsertDocumentAsync(_selectedCollection, newDoc);
            if (success)
            {
                Snackbar.Add($"Document created with ID: {docId}", Severity.Success);
                await LoadDocuments();
            }
            else
            {
                Snackbar.Add($"Failed to create document: {error}", Severity.Error);
            }
        }
    }
}
