@page "/users"
@inject ServerConnectionService Connection
@inject AdminAuthService Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Users & Roles - AdvGenNoSQL Admin</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">Users &amp; Roles</MudText>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_loading" Class="mr-2">Refresh</MudButton>
    @if (IsAdmin)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateUser">New User</MudButton>
    }
</div>

@if (!Auth.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning">
        You are not logged in. <MudLink OnClick="@(() => Navigation.NavigateTo("/login"))">Go to login</MudLink>.
    </MudAlert>
}
else if (!IsAdmin)
{
    <MudAlert Severity="Severity.Warning">
        User management requires the <b>admin</b> role. You are logged in as @Auth.CurrentUser (@Auth.CurrentRole).
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudTextField T="string" @bind-Value="_search" Placeholder="Search users..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Class="mb-4" />
        @if (_loading)
        {
            <div class="d-flex justify-center pa-8"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
        }
        else
        {
            <MudTable Items="FilteredUsers" Hover="true" Dense="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Created</MudTh>
                    <MudTh Style="width:170px">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Username">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2">@context.Username</MudText>
                            @if (context.Username == Auth.CurrentUser)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">you</MudChip>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Role">
                        <MudChip T="string" Size="Size.Small" Color="@RoleColor(context.Role)">@context.Role</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Title="Change role" OnClick="@(() => ChangeRole(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Password" Size="Size.Small" Title="Reset password" OnClick="@(() => ResetPassword(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Title="Delete user"
                                       Disabled="@(context.Role == "admin" && AdminCount <= 1)" OnClick="@(() => DeleteUser(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4" Align="Align.Center">No users found.</MudText>
                </NoRecordsContent>
            </MudTable>
            <MudText Typo="Typo.caption" Class="mt-3 d-block">@_users.Count user(s) · @AdminCount admin(s)</MudText>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Built-in roles</MudText>
        <MudSimpleTable Dense="true" Bordered="true">
            <tbody>
                <tr><td><MudChip T="string" Size="Size.Small" Color="Color.Error">admin</MudChip></td><td>Full access, including user management and dropping collections/databases.</td></tr>
                <tr><td><MudChip T="string" Size="Size.Small" Color="Color.Info">readwrite</MudChip></td><td>Read and write documents; create collections. No user management.</td></tr>
                <tr><td><MudChip T="string" Size="Size.Small" Color="Color.Default">readonly</MudChip></td><td>Read-only access to data.</td></tr>
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="mt-2 d-block">
            The last remaining admin cannot be deleted or demoted. Role and password changes revoke the user's active sessions.
        </MudText>
    </MudPaper>
}

@code {
    private List<AdminUser> _users = new();
    private string _search = "";
    private bool _loading = true;

    private bool IsAdmin => Auth.IsAuthenticated && Auth.CurrentRole == "admin";
    private int AdminCount => _users.Count(u => u.Role == "admin");

    private IEnumerable<AdminUser> FilteredUsers =>
        string.IsNullOrWhiteSpace(_search)
            ? _users
            : _users.Where(u => u.Username.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || !IsAdmin) { _loading = false; return; }
        await LoadAsync();
    }

    private static Color RoleColor(string role) => role switch
    {
        "admin" => Color.Error,
        "readwrite" => Color.Info,
        _ => Color.Default
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try { _users = await Connection.GetUsersAsync(); }
        catch (Exception ex) { Snackbar.Add($"Failed to load users: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateUser()
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Mode, "create" },
            { x => x.Message, "Create a new server user." },
            { x => x.ConfirmText, "Create" },
            { x => x.InitialRole, "readwrite" }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>("New User", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not UserDialog.UserDialogResult r) return;
        try
        {
            await Connection.CreateUserAsync(r.Username, r.Password, r.Role);
            Snackbar.Add($"User '{r.Username}' created", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ChangeRole(AdminUser user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Mode, "role" },
            { x => x.Message, $"Change the role for '{user.Username}'." },
            { x => x.ConfirmText, "Save" },
            { x => x.InitialUsername, user.Username },
            { x => x.InitialRole, user.Role }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>($"Role — {user.Username}", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not UserDialog.UserDialogResult r) return;
        try
        {
            await Connection.SetUserRoleAsync(user.Username, r.Role);
            Snackbar.Add($"Role updated for '{user.Username}'", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ResetPassword(AdminUser user)
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { x => x.Mode, "password" },
            { x => x.Message, $"Set a new password for '{user.Username}'." },
            { x => x.ConfirmText, "Reset" },
            { x => x.InitialUsername, user.Username }
        };
        var dialog = await DialogService.ShowAsync<UserDialog>($"Password — {user.Username}", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not UserDialog.UserDialogResult r) return;
        try
        {
            await Connection.SetUserPasswordAsync(user.Username, r.Password);
            Snackbar.Add($"Password reset for '{user.Username}'", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteUser(AdminUser user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Delete user '{user.Username}'? This cannot be undone." },
            { x => x.ConfirmText, "Delete" }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete User", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false) return;
        try
        {
            await Connection.DeleteUserAsync(user.Username);
            Snackbar.Add($"User '{user.Username}' deleted", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}